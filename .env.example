AUTH_SECRET=replace_with_32_char_random_string
# Generate with: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_URL_DEV=http://localhost:4000

# Vercel KV (Upstash) — for rate limiting + session storage + watchlist
KV_REST_API_URL=https://your-kv-instance.upstash.io
KV_REST_API_TOKEN=replace_with_kv_token

# Admin user (has subscription auto-granted for testing)
# bcrypt hash of password — generate with: node -e "require('bcryptjs').hash('YourPassword123', 10).then(h=>console.log(h))"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=$2a$10$...

# Stripe (swap these for Razorpay keys if preferred — see src/lib/payments.ts)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_PREMIUM=price_...

# If using Razorpay instead of Stripe:
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=replace_with_razorpay_secret
# RAZORPAY_WEBHOOK_SECRET=replace_with_razorpay_webhook_secret

# Allowed origins for auth API (CORS-like protection on POST routes)
ALLOWED_ORIGIN=https://your-domain.com

# Vercel
VERCEL_URL=your-app.vercel.app
NODE_ENV=production
